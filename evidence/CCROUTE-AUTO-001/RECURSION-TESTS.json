{
  "schemaVersion": 1,
  "tp": "TP-CCROUTE-AUTO-001",
  "suite": "recursion",
  "status": "PASS",
  "primaryGuard": {
    "module": "src/security/recursion-guard.ts",
    "cliHook": "program.hook(preAction) -> assertPrimaryRecursionGuard",
    "env": [
      "CCROUTE_CHILD",
      "CCROUTE_DEPTH",
      "CCROUTE_ROLE",
      "CCROUTE_RUN_ID"
    ],
    "rules": {
      "depthMissing": 0,
      "depth0": "allowed",
      "depth1AndChild": "reject",
      "depthGt1": "reject unconditional",
      "malformedDepth": "fail closed"
    },
    "cliSmoke": {
      "childExitCode": 31,
      "depth2ExitCode": 31
    }
  },
  "modDefence": {
    "module": "src/integrations/commandcode-mod/recursion.ts",
    "hook": "beforeToolCall",
    "identityParsing": true,
    "substringOnly": false
  },
